---
import AuthStatus from './auth/AuthStatus';
import VotingFeatureLink from './voting/VotingFeatureLink';
import { communityConfig } from '../config/community';
---
<header transition:persist="site-header" class="sticky top-0 z-50 border-b border-white/10 bg-ink-950/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8" aria-label="Primary navigation">
    <a href="/" class="flex min-w-0 items-center gap-3 font-semibold text-white">
      <img src="/images/braga-brain-network.webp" alt="" width="48" height="48" class="h-12 w-12 shrink-0 object-contain" decoding="async" />
      <span class="hidden max-[359px]:inline">Braga AI</span>
      <span class="truncate max-[359px]:hidden">{communityConfig.name}</span>
    </a>

    <div class="hidden items-center gap-5 md:flex">
      <a class="nav-link" href="/posts">Posts</a>
      <a class="nav-link" href="/events">Events</a>
      <VotingFeatureLink className="nav-link" client:load />
      <a class="nav-link" href="/members">Members</a>
      <a class="rounded-full border border-limewash/45 px-4 py-2 text-sm font-bold text-limewash transition hover:border-limewash hover:bg-limewash hover:text-ink-950" href="/create">Create</a>
      <AuthStatus client:load />
    </div>

    <details class="mobile-menu relative md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-white">Menu</summary>
      <div class="absolute right-0 mt-3 w-64 space-y-2 rounded-3xl border border-white/10 bg-ink-950 p-4 shadow-2xl">
        <a class="mobile-nav-link" href="/posts">Posts</a>
        <a class="mobile-nav-link" href="/events">Events</a>
        <VotingFeatureLink className="mobile-nav-link" client:load />
        <a class="mobile-nav-link" href="/members">Members</a>
        <a class="mobile-nav-link text-limewash" href="/create">Create your community</a>
        <AuthStatus client:load />
      </div>
    </details>
  </nav>
</header>

<script>
  document.addEventListener('astro:before-preparation', () => {
    const menu = document.querySelector<HTMLDetailsElement>('header[data-astro-transition-persist="site-header"] details.mobile-menu');
    if (menu) menu.removeAttribute('open');
  });
</script>
